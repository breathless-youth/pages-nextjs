# 베타 테스터 신청 저장 (/api/beta/signup)
#
# Supabase 대시보드 > Project Settings > API 에서 가져온다.
# service_role 키는 RLS 를 우회하므로 절대 클라이언트에 노출하면 안 된다 —
# Vercel 에서는 Environment Variables 에만 넣고 NEXT_PUBLIC_ 접두사를 붙이지 않는다.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# 신청이 들어오면 알림을 보낼 Slack Incoming Webhook (선택).
# 비워 두면 알림 없이 저장만 한다.
SLACK_WEBHOOK_URL=
