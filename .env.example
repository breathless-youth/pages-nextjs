# 베타 테스터 신청 저장 (/api/beta/signup)
# 로컬에서 쓰려면 이 파일을 .env.local 로 복사해 값을 채운다.
#
# Supabase 대시보드 > Project Settings > API
#   - SUPABASE_URL        : Project URL
#   - SUPABASE_SECRET_KEY : "secret" 키(sb_secret_…). 예전 프로젝트라면
#                           service_role 키(eyJ…)를 넣어도 된다.
#
# secret/service_role 키는 RLS 를 우회한다. 절대 클라이언트에 노출하면 안 되고
# NEXT_PUBLIC_ 접두사를 붙이지 않는다 — lib/supabase-admin.ts 가 "server-only"
# 로 클라이언트 번들 유입을 빌드 타임에 막고 있다.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SECRET_KEY=

# 신청이 들어오면 알림을 보낼 Slack Incoming Webhook (선택).
# 비워 두면 알림 없이 저장만 한다.
SLACK_WEBHOOK_URL=
